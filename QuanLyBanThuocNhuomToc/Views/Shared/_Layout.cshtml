<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HairDyeShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">

        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-palette-fill"></i>
                HairDyeShop
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">

                <!-- Menu trái -->
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Trang chủ
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SanPham" asp-action="Index">
                            <i class="bi bi-box"></i> Sản phẩm
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DanhMuc" asp-action="Index">
                            <i class="bi bi-grid"></i> Danh mục
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DonHang" asp-action="Index">
                            <i class="bi bi-cart-check"></i> Đơn hàng
                        </a>
                    </li>

                </ul>

                <!-- Tìm kiếm -->
                <form class="d-flex me-3"
                      asp-controller="SanPham"
                      asp-action="Index"
                      method="get">

                    <input class="form-control me-2"
                           type="search"
                           name="keyword"
                           placeholder="Tìm sản phẩm...">

                    <button class="btn btn-warning">
                        <i class="bi bi-search"></i>
                    </button>

                </form>

                <!-- Giỏ hàng -->
                <a asp-controller="GioHang"
                   asp-action="Index"
                   class="btn btn-outline-light me-3">

                    <i class="bi bi-cart3"></i>
                    Giỏ hàng

                </a>

                <!-- Tài khoản -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">

                        <button class="btn btn-success dropdown-toggle"
                                data-bs-toggle="dropdown">

                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="TaiKhoan"
                                   asp-action="ThongTin">

                                    Hồ sơ

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="DonHang"
                                   asp-action="LichSu">

                                    Đơn hàng của tôi

                                </a>
                            </li>

                            @if (User.IsInRole("Quản trị"))
                            {
                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="SanPham"
                                       asp-action="Index">

                                        Quản lý sản phẩm

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DanhMuc"
                                       asp-action="Index">

                                        Quản lý danh mục

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DonHang"
                                       asp-action="Index">

                                        Quản lý đơn hàng

                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="TaiKhoan"
                                   asp-action="DangXuat">

                                    Đăng xuất

                                </a>
                            </li>

                        </ul>

                    </div>
                }
                else
                {
                    <a asp-controller="TaiKhoan"
                       asp-action="DangNhap"
                       class="btn btn-outline-light me-2">

                        Đăng nhập

                    </a>

                    <a asp-controller="TaiKhoan"
                       asp-action="DangKy"
                       class="btn btn-warning">

                        Đăng ký

                    </a>
                }

            </div>

        </div>

    </nav>

    <div class="container mt-4">

        @RenderBody()

    </div>

    <footer class="bg-dark text-white mt-5 py-4">

        <div class="container text-center">

            <h5>HairDyeShop</h5>

            <p>
                Hệ thống bán thuốc nhuộm tóc chính hãng
            </p>

            <small>

                © 2026 HairDyeShop - ASP.NET Core MVC

            </small>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>