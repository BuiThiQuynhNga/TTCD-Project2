@model QuanLyBanThuocNhuomToc.Models.SanPham

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container py-4">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">
                <i class="bi bi-plus-circle"></i>
                Thêm sản phẩm mới
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Them" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">

                    <!-- Cột trái -->
                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="TenSanPham" class="form-label fw-bold"></label>
                            <input asp-for="TenSanPham" class="form-control" />
                            <span asp-validation-for="TenSanPham" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục</label>
                            <select asp-for="MaDanhMuc"
                                    asp-items="ViewBag.MaDanhMuc"
                                    class="form-select">
                            </select>
                            <span asp-validation-for="MaDanhMuc" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaMau" class="form-label fw-bold"></label>
                            <input asp-for="MaMau" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="GiaBan" class="form-label fw-bold"></label>
                            <input asp-for="GiaBan"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="GiaBan" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Cột phải -->
                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="SoLuongTon" class="form-label fw-bold"></label>
                            <input asp-for="SoLuongTon"
                                   type="number"
                                   class="form-control" />
                            <span asp-validation-for="SoLuongTon" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HinhAnh" class="form-label fw-bold"></label>
                            <input asp-for="HinhAnh"
                                   id="HinhAnh"
                                   class="form-control" />
                        </div>

                        <div class="text-center">

                            <img id="preview"
                                 src="~/images/no-image.png"
                                 class="img-thumbnail"
                                 style="width:220px;height:220px;object-fit:cover;"
                                 onerror="this.src='/images/no-image.png'" />

                        </div>

                    </div>

                </div>

                <div class="mt-3">

                    <label asp-for="MoTaSanPham" class="form-label fw-bold"></label>

                    <textarea asp-for="MoTaSanPham"
                              class="form-control"
                              rows="5">
                    </textarea>

                </div>

                <hr />

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-save"></i>
                    Lưu sản phẩm
                </button>

                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("HinhAnh").addEventListener("keyup", function () {

            let img = document.getElementById("preview");

            if (this.value.trim() !== "") {
                img.src = "/images/" + this.value;
            } else {
                img.src = "/images/no-image.png";
            }

        });
    </script>

}