@model QuanLyBanThuocNhuomToc.Models.SanPham

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container py-4">

    <div class="card shadow border-0">

        <div class="card-header bg-warning text-dark">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Chỉnh sửa sản phẩm
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Sua" method="post">

                <input type="hidden" asp-for="MaSanPham" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">

                    <!-- Cột trái -->
                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="TenSanPham" class="form-label fw-bold"></label>
                            <input asp-for="TenSanPham" class="form-control" />
                            <span asp-validation-for="TenSanPham" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục</label>
                            <select asp-for="MaDanhMuc"
                                    asp-items="ViewBag.MaDanhMuc"
                                    class="form-select">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaMau" class="form-label fw-bold"></label>
                            <input asp-for="MaMau" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="GiaBan" class="form-label fw-bold"></label>
                            <input asp-for="GiaBan" class="form-control" type="number" step="0.01" />
                        </div>

                    </div>

                    <!-- Cột phải -->
                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="SoLuongTon" class="form-label fw-bold"></label>
                            <input asp-for="SoLuongTon" class="form-control" type="number" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="HinhAnh" class="form-label fw-bold"></label>
                            <input asp-for="HinhAnh"
                                   class="form-control"
                                   id="HinhAnh" />
                        </div>

                        <div class="text-center mb-3">

                            <img id="preview"
                                 src="~/images/@(string.IsNullOrEmpty(Model.HinhAnh) ? "no-image.png" : Model.HinhAnh)"
                                 class="img-thumbnail"
                                 style="width:220px;height:220px;object-fit:cover;"
                                 onerror="this.src='/images/no-image.png'" />

                        </div>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="MoTaSanPham" class="form-label fw-bold"></label>

                    <textarea asp-for="MoTaSanPham"
                              class="form-control"
                              rows="5">
                    </textarea>

                </div>

                <hr />

                <button class="btn btn-warning px-4">
                    <i class="bi bi-save"></i>
                    Cập nhật
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary px-4">

                    <i class="bi bi-arrow-left"></i>

                    Quay lại

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.getElementById("HinhAnh")
            .addEventListener("keyup", function () {

                document.getElementById("preview").src =
                    "/images/" + this.value;

            });

    </script>

}