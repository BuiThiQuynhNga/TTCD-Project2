@model IEnumerable<QuanLyBanThuocNhuomToc.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container py-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                📦 Quản Lý Sản Phẩm
            </h3>

            <a asp-action="Them" class="btn btn-light">
                ➕ Thêm sản phẩm
            </a>
        </div>

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-dark text-center">

                    <tr>
                        <th width="60">ID</th>
                        <th width="100">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Mã màu</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th width="180">Thao tác</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="text-center">
                                @item.MaSanPham
                            </td>

                            <td class="text-center">

                                <img src="~/images/@(string.IsNullOrEmpty(item.HinhAnh) ? "no-image.png" : item.HinhAnh)"
                                     width="70"
                                     height="70"
                                     style="object-fit:cover;border-radius:10px"
                                     onerror="this.src='/images/no-image.png'">

                            </td>

                            <td>

                                <strong>
                                    @item.TenSanPham
                                </strong>

                            </td>

                            <td>

                                @item.DanhMucSanPham?.TenDanhMuc

                            </td>

                            <td>

                                <span class="badge bg-secondary">
                                    @item.MaMau
                                </span>

                            </td>

                            <td class="text-danger fw-bold">

                                @item.GiaBan.ToString("N0") VNĐ

                            </td>

                            <td>

                                @if (item.SoLuongTon > 100)
                                {
                                    <span class="badge bg-success">
                                        Còn @item.SoLuongTon
                                    </span>
                                }
                                else if (item.SoLuongTon > 20)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Còn @item.SoLuongTon
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Sắp hết (@item.SoLuongTon)
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Sua"
                                   asp-route-id="@item.MaSanPham"
                                   class="btn btn-warning btn-sm">
                                    ✏️ Sửa
                                </a>

                                <a asp-action="Xoa"
                                   asp-route-id="@item.MaSanPham"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                                    🗑 Xóa
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>